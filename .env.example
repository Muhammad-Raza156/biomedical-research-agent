# ───────────── LLM (plug-and-play: change LLM_MODEL + set that provider's key) ─────────────
# Format "<provider>:<model>". Examples:
#   google_genai:gemini-2.5-flash   (free tier, needs GOOGLE_API_KEY)  ← default
#   groq:llama-3.3-70b-versatile     (free tier, needs GROQ_API_KEY)
#   openai:gpt-4o-mini               (paid, needs OPENAI_API_KEY)
#   anthropic:claude-haiku-4-5       (paid, needs ANTHROPIC_API_KEY)
#   ollama:qwen2.5:14b               (local, needs OLLAMA_BASE_URL)
LLM_MODEL=google_genai:gemini-2.5-flash
LLM_TEMPERATURE=0
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Shared (all workers) LLM request budget; keep under your free tier's per-minute cap.
LLM_REQUESTS_PER_MINUTE=8
# USD per million tokens, for the cost estimate in the final answer (0 for free tiers).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# ───────────── Corpus definition (change CORPUS_VERSION whenever you change any of these) ─────────────
CORPUS_VERSION=v1
CORPUS_QUERY=metformin[majr] AND neoplasms[majr] AND diabetes mellitus, type 2[mh] AND (cohort studies[mh] OR meta-analysis[pt])
CORPUS_MIN_DATE=2005
CORPUS_MAX_DATE=2025
CORPUS_MAX_RESULTS=400
CORPUS_CUTOFF_YEAR=2016

# ───────────── NCBI E-utilities ─────────────
# Optional. Without a key the limit is 3 req/s; with a key 10 req/s.
NCBI_API_KEY=
NCBI_EMAIL=you@example.com
NCBI_TOOL=biomed-research-agent
NCBI_RATE_NO_KEY=2.5
NCBI_RATE_WITH_KEY=9
FETCH_BATCH_SIZE=50
LINK_BATCH_SIZE=50
LOAD_BATCH_SIZE=50
STAGING_DIR=/data/staging
INGEST_CONTINUE_AS_NEW_EVENTS=2000

# ───────────── Infrastructure (Docker-internal hostnames) ─────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
REDIS_URL=redis://redis:6379/0
GRAPH_URI=bolt://neo4j:7687
GRAPH_USER=neo4j
GRAPH_PASSWORD=change-me-neo4j-pw
GRAPH_DATABASE=neo4j
GRAPH_TEST_DATABASE=test
GRAPH_READER_USER=agent_reader
GRAPH_READER_PASSWORD=change-me-reader-pw
GRAPH_HTTP_URL=http://neo4j:7474
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=change-me-postgres-pw
POSTGRES_DB=langgraph
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ───────────── Agent ─────────────
AGENT_MAX_ITERATIONS=12
AGENT_MAX_VERIFIER_REJECTIONS=2
AGENT_MAX_CYPHER_RETRIES=3
CYPHER_TIMEOUT_SECONDS=10
CYPHER_MAX_LIMIT=200
CLARIFY_TIMEOUT_SECONDS=600
RESEARCH_MAX_CONCURRENT_RUNS=4

# ───────────── Streams / SSE ─────────────
STREAM_MAXLEN=5000
STREAM_TTL_SECONDS=604800
SSE_BLOCK_MS=15000
